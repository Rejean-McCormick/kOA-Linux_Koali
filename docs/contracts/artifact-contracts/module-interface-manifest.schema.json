{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.koa.local/artifact-contracts/module-interface-manifest.schema.json",
  "title": "Koali Product Interface Manifest",
  "description": "Declarative product interface contribution that can be mounted by an admitted Koali composition host while preserving product-owned standalone operation, internal navigation, page behavior, business authorization, and removal independence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "manifest_version",
    "module_id",
    "public_name",
    "home_route_id",
    "routes",
    "sidebar",
    "topbar_widgets",
    "offline_behavior",
    "authority_boundary"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "manifest_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
    },
    "public_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "icon_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "home_route_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./route-contribution.schema.json"
      }
    },
    "sidebar": {
      "$ref": "./sidebar-navigation.schema.json",
      "description": "Surface-level navigation contribution rendered by the active Koali shell host. It does not replace product-owned inner navigation and does not make kOA Spaces a standalone-runtime dependency."
    },
    "topbar_widgets": {
      "type": "array",
      "items": {
        "$ref": "./topbar-widget.schema.json"
      }
    },
    "localization_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyboard_navigation",
        "screen_reader_labels",
        "reduced_motion"
      ],
      "properties": {
        "keyboard_navigation": {
          "const": true
        },
        "screen_reader_labels": {
          "const": true
        },
        "reduced_motion": {
          "enum": [
            "supported",
            "not_applicable"
          ]
        }
      }
    },
    "offline_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_state",
        "fallback_route_id"
      ],
      "properties": {
        "module_state": {
          "enum": [
            "available",
            "cached_read_only",
            "degraded",
            "unavailable"
          ]
        },
        "fallback_route_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        }
      }
    },
    "authority_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "presentation_only",
        "may_grant_capabilities",
        "direct_domain_writes",
        "menu_visibility_is_authorization"
      ],
      "properties": {
        "presentation_only": {
          "const": true
        },
        "may_grant_capabilities": {
          "const": false
        },
        "direct_domain_writes": {
          "const": false
        },
        "menu_visibility_is_authorization": {
          "const": false
        }
      },
      "description": "Presentation authority boundary. Visibility and capability projection never replace owner-side authorization."
    },
    "shell_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_shell_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "max_shell_version": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "design_system_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "design_system_id": {
          "type": "string",
          "minLength": 1
        },
        "min_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "asset_bundle_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Optional reference to a locally admitted interface asset manifest for this module surface."
    },
    "surface_contract_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "product_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
      "description": "Stable independently packaged product identity. It may equal module_id when one module represents one product."
    },
    "ui_modes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "standalone",
        "integrated",
        "composition_host_required_for_standalone",
        "private_cross_product_ui_imports"
      ],
      "properties": {
        "standalone": {
          "enum": [
            "supported",
            "not_applicable"
          ]
        },
        "integrated": {
          "enum": [
            "supported",
            "not_applicable"
          ]
        },
        "composition_host_required_for_standalone": {
          "const": false
        },
        "private_cross_product_ui_imports": {
          "const": false
        }
      }
    },
    "surface_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface_id",
          "home_route_id",
          "route_ids"
        ],
        "properties": {
          "surface_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "home_route_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "route_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
            }
          },
          "navigation_mode": {
            "enum": [
              "manifest_navigation",
              "product_owned_inner_navigation"
            ]
          },
          "density": {
            "enum": [
              "compact",
              "standard",
              "touch"
            ]
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "label",
          "required_capabilities"
        ],
        "properties": {
          "command_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "route_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "required_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "surface_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "inspectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inspector_id",
          "label",
          "surface_ids"
        ],
        "properties": {
          "inspector_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "surface_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "ui_modes"
        ]
      },
      "then": {
        "required": [
          "product_id",
          "surface_profiles"
        ]
      }
    }
  ]
}
