{
  "$schema": "../../schemas/subsystem.schema.json",
  "subsystem_id": "koa_spaces",
  "title": "kOA Spaces",
  "status": "active",
  "version": "1.1.0",
  "relationship_to_koa": "integrated_optional_subsystem",
  "optional": true,
  "replaceable": true,
  "offline_capable": true,
  "koa_role": "Independent optional integrated experience-composition host that assembles admitted product interface contributions without owning product standalone runtimes or business authority.",
  "official_documentation": {
    "mount_path": "subsystems/koa-spaces",
    "mount_kind": "directory_junction_or_symbolic_link",
    "required_for_final_alignment": true,
    "authority": "subsystem_internal_documentation"
  },
  "koa_owns": [
    "deployment profile membership",
    "process lifecycle and activation",
    "resource envelope",
    "identity and capability assertions exposed to the subsystem",
    "network and storage exposure",
    "artifact admission for Space definitions and interface manifests",
    "health integration",
    "backup coordination for presentation state",
    "safe degradation and removal behavior"
  ],
  "koa_does_not_own": [
    "kOA Spaces internal implementation",
    "business data represented by interface modules",
    "subsystem workflow or state",
    "course and learning progress authority",
    "media authority",
    "authorization decisions",
    "module-specific page implementation",
    "direct cross-subsystem writes",
    "duplicate business functions of contributing systems",
    "public Internet dependency for locally declared offline-capable presentation"
  ],
  "presentation_model": {
    "public_name": "kOA Spaces",
    "module_selector_position": "upper_left",
    "topbar_alignment": "same_horizontal_band_as_module_selector",
    "sidebar_source": "active_module_manifest",
    "main_surface": "single_shared_page_surface",
    "sidebar_visible_depth": 2,
    "public_module_aliases_allowed": true,
    "stable_module_ids_required": true,
    "technology_alignment": "shared_visual_and_interaction_patterns_allowed_without_business_function_duplication",
    "web_technology_implies_internet_dependency": false,
    "offline_local_assets": "required_for_declared_offline_capable_surfaces",
    "composition_host_role": "optional_integrated_host",
    "product_registry_source": "installed_and_admitted_product_manifests",
    "hard_coded_product_registry": false,
    "product_standalone_operation_preserved": true,
    "shared_shell_contract": "reusable_koali_ui_primitives_not_spaces_business_authority",
    "surface_profiles": "product_owned_projections",
    "context_inspector_content_owner": "active_product"
  },
  "artifact_contracts": [
    "contracts/artifact-contracts/space-definition.schema.json",
    "contracts/artifact-contracts/module-interface-manifest.schema.json",
    "contracts/artifact-contracts/sidebar-navigation.schema.json",
    "contracts/artifact-contracts/topbar-widget.schema.json",
    "contracts/artifact-contracts/route-contribution.schema.json",
    "contracts/artifact-contracts/space-activation-receipt.schema.json",
    "contracts/artifact-contracts/interface-theme.schema.json",
    "contracts/artifact-contracts/interface-asset-manifest.schema.json",
    "contracts/artifact-contracts/product-surface-profile.schema.json",
    "contracts/artifact-contracts/presentation-preferences.schema.json",
    "contracts/artifact-contracts/accent-palette.schema.json"
  ],
  "boundary_rules": {
    "direct_cross_subsystem_writes": "prohibited",
    "undeclared_substitution": "prohibited",
    "internal_behavior_duplication": "prohibited",
    "presentation_grants_authority": false,
    "menu_visibility_is_authorization": false,
    "remote_executable_extensions_from_space_definitions": "prohibited",
    "official_documentation_mount": "subsystems/koa-spaces",
    "space_alias_changes_module_identity": false,
    "interface_manifest_may_bypass_module_authorization": false,
    "module_routes_are_contributions_not_authority": true,
    "replacement_preserves_business_state": true,
    "frontend_alignment_transfers_business_authority": false,
    "duplicate_subsystem_business_functions": "prohibited",
    "public_internet_required_for_local_offline_surface": false,
    "product_standalone_operation_depends_on_koa_spaces": false,
    "private_cross_product_ui_imports_for_shell_behavior": "prohibited",
    "product_removal_requires_unrelated_ui_source_changes": false,
    "integrated_product_registry_hard_coded": "prohibited"
  },
  "documentation": {
    "koa_boundary_document": "04-components/subsystems/koa-spaces.md",
    "system_layer_document": "02-system/21-koa-spaces-experience-layer.md",
    "composition_document": "02-system/22-koa-spaces-interface-composition.md",
    "activation_recipe": "11-recipes/user-lightweight/koa-spaces-activation.md",
    "design_system_document": "02-system/24-koa-spaces-design-system.md",
    "reference_frontend_recipe": "11-recipes/user-lightweight/koa-spaces-reference-frontend.md"
  },
  "authority": "non_authoritative_presentation",
  "core_dependency": "declared_interfaces_only",
  "activation_model": "profile_conditioned_atomic_activation",
  "deactivation_effect": "integrated_composition_unavailable_product_standalone_and_business_authority_preserved"
}
