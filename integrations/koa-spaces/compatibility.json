  "common_interfaces": {
    "transport": "interfaces/transport/http-over-unix.toml",
    "health": "interfaces/health/health-status.schema.json",
    "readiness": "interfaces/health/readiness.schema.json",
    "receipts": "interfaces/receipts/receipt-envelope.schema.json",
    "identity_context": "interfaces/identity/identity-context.schema.json",
    "capabilities": "interfaces/capabilities/capability-snapshot.schema.json",
    "status": "required_but_not_present_in_supplied_branch"
  },
  "profiles": {
    "user_lightweight": "supported_optional",
    "developer_linux_workstation": "supported_optional_stopped",
    "developer_windows_wsl": "supported_optional_stopped",
    "sovereign_linux_node": "supported_optional",
    "sovereign_hub": "supported_optional_multi_space",
    "sovereign_offline": "supported_with_local_artifact_restrictions",
    "high_assurance": "supported_with_signed_or_hash_pinned_artifacts",
    "appliance_shell": "supported_optional_primary_surface",
    "build_farm": "artifact_build_and_validation_only",
    "control_plane": "observation_and_distribution_only"
  },
  "compatibility_rules": {
    "major_version_mismatch": "reject",
    "unknown_artifact_version": "reject",
    "unknown_widget_kind": "reject",
    "unknown_route_action": "reject",
    "missing_optional_module": "omit_without_substitution",
    "missing_required_module": "block_activation",
    "source_pin_unresolved": "block_build_and_activation",
    "theme_missing_or_invalid": "block_activation",
    "required_asset_bundle_missing": "block_activation",
    "optional_asset_bundle_missing": "disable_contribution_and_report",
    "remote_runtime_asset_dependency": "reject",
    "shell_asset_manifest_missing": "block_activation",
    "product_removed": "remove_product_contributions_only",
    "composition_host_removed": "preserve_product_standalone_interfaces",
    "hard_coded_product_registry": "reject"
  },
  "ui_modularity": {
    "role": "optional_integrated_composition_host",
    "dynamic_product_registry": true,
    "hard_coded_product_list": false,
    "product_standalone_interfaces_preserved_when_absent": true,
    "private_cross_product_ui_imports": false
  }
}
